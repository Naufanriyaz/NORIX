
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #faf8f7;
      color: #252525;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .top-line,
    .bottom-line {
      height: 3px;
      background: #159cff;
      width: 100%;
    }

    .main-content {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 25px 15px;
    }

    .login-wrapper {
      width: 100%;
      max-width: 450px;
      border: 2px dotted #159cff;
      padding: 20px;
      background: #fff;
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.06);
    }

    .system-info {
      display: flex;
      justify-content: space-between;
      font-size: 9px;
      color: #777;
      margin-bottom: 45px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .orange-dot {
      color: #ff6900;
      font-size: 12px;
    }

    .heading {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }

    .heading h1 {
      font-size: 26px;
      font-weight: 700;
    }

    .version {
      color: #ff6900;
      font-size: 9px;
      font-weight: bold;
    }

    .subtitle {
      font-size: 12px;
      color: #777;
      margin-bottom: 35px;
    }

    .form-group {
      margin-bottom: 22px;
    }

    .label-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 9px;
    }

    .label-row label {
      font-size: 11px;
      font-weight: bold;
    }

    .field-info {
      font-size: 8px;
      color: #888;
      letter-spacing: 0.5px;
    }

    .input-wrapper {
      height: 46px;
      display: flex;
      align-items: center;
      border: 1px solid #e5e5e5;
      border-radius: 5px;
      padding: 0 12px;
      gap: 10px;
    }

    .input-wrapper:focus-within {
      border-color: #ff6900;
    }

    .input-wrapper .input-icon {
      color: #555;
      font-size: 16px;
    }

    .input-wrapper input {
      width: 100%;
      border: none;
      outline: none;
      font-size: 12px;
      background: transparent;
      color: #333;
    }

    .input-wrapper input::placeholder {
      color: #aaa;
    }

    .password-toggle {
      border: none;
      background: transparent;
      cursor: pointer;
      font-size: 15px;
      color: #777;
    }

    .options {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 10px;
      margin: 5px 0 28px;
    }

    .remember {
      display: flex;
      align-items: center;
      gap: 7px;
      color: #777;
    }

    .remember input {
      accent-color: #ff6900;
    }

    .options a {
      color: #555;
      text-decoration: none;
    }

    .options a:hover {
      color: #ff6900;
    }

    .error-message {
      background: #fff0ed;
      border: 1px solid #ffd1c7;
      color: #c0392b;
      font-size: 11px;
      padding: 10px;
      border-radius: 4px;
      margin-bottom: 20px;
    }

    .submit-btn {
      width: 100%;
      height: 48px;
      border: none;
      border-radius: 5px;
      background: linear-gradient(90deg, #ff6900, #ff851c);
      color: white;
      font-size: 13px;
      font-weight: bold;
      cursor: pointer;
      box-shadow: 0 4px 10px rgba(255, 105, 0, 0.2);
      transition: 0.2s;
    }

    .submit-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 15px rgba(255, 105, 0, 0.3);
    }

    .submit-btn span {
      margin-left: 8px;
    }

    .secure-connect {
      text-align: center;
      font-size: 8px;
      color: #999;
      margin: 22px 0 18px;
      letter-spacing: 0.5px;
    }

    .security-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #f5f4f3;
      padding: 14px 12px;
      font-size: 8px;
      font-weight: bold;
      color: #666;
      letter-spacing: 0.3px;
    }

    .security-bar .secure {
      color: #e66a00;
    }

    .security-bar .online {
      color: #777;
    }

    .security-bar .online span {
      color: #ff6900;
    }

    .system-footer {
      display: flex;
      justify-content: space-between;
      font-size: 8px;
      color: #777;
      padding-top: 12px;
      text-transform: uppercase;
    }

    footer {
      border-top: 3px solid #159cff;
      padding: 30px 15px 20px;
      text-align: center;
    }

    .brand {
      font-size: 24px;
      font-weight: 800;
      letter-spacing: 1px;
      margin-bottom: 45px;
    }

    .brand span {
      color: #ff6900;
    }

    .copyright {
      font-size: 10px;
      color: #777;
    }

    .copyright a {
      color: #777;
      text-decoration: none;
      margin: 0 7px;
    }

    @media (max-width: 480px) {
      .login-wrapper {
        padding: 18px;
      }

      .system-info {
        margin-bottom: 35px;
      }

      .heading h1 {
        font-size: 23px;
      }

      .brand {
        margin-bottom: 30px;
      }

      .copyright {
        line-height: 2;
      }
    }
  </style>
</head>

<body>

  <div class="top-line"></div>

  <main class="main-content">

    <section class="login-wrapper">

      <div class="system-info">
        <span><span class="orange-dot">●</span> Gateway / ID.001</span>
        <span>⚡ Latency 0.8ms</span>
      </div>

      <div class="heading">
        <h1>Welcome Back</h1>
        <span class="version">AUTH v4.2</span>
      </div>

      <p class="subtitle">
        Sign in to continue your gaming journey.
      </p>

      <% if (error) { %>
        <div class="error-message">
          <% if (error === 'empty') { %>
            Please enter email and password.
          <% } else if (error === 'invalid') { %>
            Invalid email or password.
          <% } else if (error === 'blocked') { %>
            This admin account is blocked.
          <% } else if (error === 'unverified') { %>
            This account is not verified.
          <% } else { %>
            Something went wrong. Please try again.
          <% } %>
        </div>
      <% } %>

      <form action="/admin/login" method="POST">

        <div class="form-group">
          <div class="label-row">
            <label for="email">Email Address</label>
            <span class="field-info">USER.IDENTITY</span>
          </div>

          <div class="input-wrapper">
            <span class="input-icon">✉</span>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="name@example.com"
              autocomplete="username"
              required
            >
          </div>
        </div>

        <div class="form-group">
          <div class="label-row">
            <label for="password">Password</label>
            <span class="field-info">KEY.TOKEN</span>
          </div>

          <div class="input-wrapper">
            <span class="input-icon">♙</span>
            <input
              type="password"
              id="password"
              name="password"
              placeholder="••••••••"
              autocomplete="current-password"
              required
            >
            <button
              type="button"
              class="password-toggle"
              id="togglePassword"
              aria-label="Show password"
            >◉</button>
          </div>
        </div>

        <div class="options">
          <label class="remember">
            <input type="checkbox" name="rememberMe">
            Remember Me
          </label>

          <a href="#" onclick="return false;">Forgot Password?</a>
        </div>

        <button type="submit" class="submit-btn">
          SIGN IN <span>→</span>
        </button>

      </form>

      <div class="secure-connect">
        — SECURE CONNECT —
      </div>

      <div class="security-bar">
        <span class="secure">🛡 SECURE SSL 256-BIT</span>
        <span class="online">NODES ONLINE <span>●</span></span>
      </div>

      <div class="system-footer">
        <span>Locale: Global / EN-US</span>
        <span>SYS: NORIX-OS v4.2.0</span>
      </div>

    </section>

  </main>

  <footer>
    <div class="brand">NORIX <span>●</span></div>

    <p class="copyright">
      © 2026 NORIX. All rights reserved.
      <span>·</span>
      <a href="#">Privacy Policy</a>
      <span>·</span>
      <a href="#">Terms of Service</a>
    </p>
  </footer>

  <div class="bottom-line"></div>

  <script>
    const togglePassword = document.getElementById('togglePassword');
    const passwordInput = document.getElementById('password');

    togglePassword.addEventListener('click', () => {
      const isPassword = passwordInput.type === 'password';

      passwordInput.type = isPassword ? 'text' : 'password';
      togglePassword.textContent = isPassword ? '◎' : '◉';
      togglePassword.setAttribute(
        'aria-label',
        isPassword ? 'Hide password' : 'Show password'
      );
    });
  </script>

</body>
</html>
