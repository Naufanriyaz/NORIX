
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f6f4f3;
      color: #292929;
    }

    /* SIDEBAR */

    .sidebar {
      width: 205px;
      height: 100vh;
      position: fixed;
      top: 0;
      left: 0;
      background: #fff;
      border-right: 1px solid #eee;
      display: flex;
      flex-direction: column;
      z-index: 10;
      overflow-y: auto;
    }

    .logo {
      padding: 25px 20px;
      font-size: 19px;
      font-weight: 800;
      border-bottom: 1px solid #eee;
    }

    .logo span {
      color: #ff6900;
      font-size: 12px;
    }

    .nav-links {
      padding: 15px 10px;
    }

    .nav-links a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px;
      margin-bottom: 4px;
      text-decoration: none;
      color: #625b57;
      font-size: 13px;
      border-radius: 5px;
    }

    .nav-links a:hover,
    .nav-links a.active {
      background: #ff6900;
      color: #fff;
    }

    .sidebar-logout-form {
      margin-top: auto;
      width: 100%;
      padding: 12px 10px;
      border-top: 1px solid #eee;
    }

    .signout {
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
      padding: 12px;
      background: transparent;
      border: none;
      border-radius: 5px;
      color: #625b57;
      font-family: inherit;
      font-size: 13px;
      text-align: left;
      cursor: pointer;
      transition: 0.2s ease;
    }

    .signout:hover {
      background: #fff0e5;
      color: #ff6900;
    }

    /* MAIN */

    .main {
      margin-left: 205px;
      min-height: 100vh;
      min-width: 0;
    }

    .content,
    .user-panel {
      min-width: 0;
    }

    .topbar {
      height: 70px;
      background: #fff;
      border-bottom: 1px solid #eee;
      padding: 0 25px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .global-search {
      width: 280px;
      padding: 11px 14px;
      border: none;
      outline: none;
      background: #f5f3f2;
      border-radius: 5px;
      font-size: 12px;
    }

    .admin-info {
      text-align: right;
      font-size: 11px;
    }

    .admin-info strong {
      display: block;
      margin-bottom: 4px;
    }

    .admin-info span {
      color: #888;
    }

    .content {
      padding: 25px;
    }

    .breadcrumb {
      font-size: 10px;
      color: #ff6900;
      font-weight: bold;
      letter-spacing: .5px;
      margin-bottom: 10px;
    }

    .heading {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      margin-bottom: 28px;
    }

    .heading h1 {
      font-size: 27px;
      margin-bottom: 8px;
    }

    .heading p {
      font-size: 12px;
      color: #888;
    }

    /* SUMMARY */

    .summary {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .summary-card {
      background: #fff;
      border: 1px solid #eee;
      border-radius: 5px;
      padding: 11px 15px;
      font-size: 11px;
      white-space: nowrap;
    }

    .summary-card strong {
      font-size: 13px;
      margin-left: 8px;
    }

    .dot {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      margin-right: 6px;
    }

    .total-dot { background: #777; }
    .active-dot { background: #00a879; }
    .blocked-dot { background: #d92323; }

    /* USER PANEL */

    .user-panel {
      background: #fff;
      border: 1px solid #eee;
      border-radius: 6px;
      overflow: hidden;
    }

    .toolbar {
      padding: 18px;
      display: flex;
      gap: 12px;
      border-bottom: 1px solid #eee;
      align-items: center;
    }

    .search-form {
      display: flex;
      flex: 1;
      gap: 8px;
    }

    .search-input {
      width: 100%;
      padding: 12px;
      background: #f5f3f2;
      border: 1px solid transparent;
      outline: none;
      border-radius: 5px;
      font-size: 12px;
    }

    .search-input:focus {
      border-color: #ff6900;
    }

    .search-btn,
    .clear-btn,
    .export-btn {
      padding: 11px 14px;
      border: none;
      border-radius: 5px;
      font-size: 11px;
      cursor: pointer;
      text-decoration: none;
      white-space: nowrap;
    }

    .search-btn {
      background: #ff6900;
      color: #fff;
    }

    .clear-btn {
      background: #eee;
      color: #555;
    }

    .export-btn {
      background: #f0edeb;
      color: #444;
    }

    /* TABLE */

    .table-wrapper {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 950px;
    }

    th {
      background: #f6f4f3;
      color: #777;
      text-align: left;
      font-size: 9px;
      letter-spacing: .5px;
      padding: 17px 12px;
    }

    td {
      padding: 15px 12px;
      border-bottom: 1px solid #eee;
      font-size: 11px;
      vertical-align: middle;
    }

    .user-cell {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .avatar {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: #ffe5d6;
      color: #ff6900;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: bold;
      flex-shrink: 0;
    }

    .user-name {
      font-weight: bold;
      font-size: 12px;
      margin-bottom: 5px;
    }

    .user-email {
      color: #888;
      font-size: 10px;
    }

    .date-text {
      color: #777;
      line-height: 1.5;
    }

    .status {
      padding: 7px 11px;
      border-radius: 20px;
      font-size: 10px;
      font-weight: bold;
      display: inline-block;
      white-space: nowrap;
    }

    .active-status {
      background: #d8f8eb;
      color: #00875c;
    }

    .blocked-status {
      background: #ffe1df;
      color: #c92d2d;
    }

    .unverified-status {
      background: #f0eeee;
      color: #777;
    }

    /* ACTION BUTTONS */

    .action-buttons {
      display: flex;
      gap: 6px;
      align-items: center;
    }

    .details-btn,
    .block-btn,
    .unblock-btn {
      padding: 8px 10px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 10px;
      font-weight: bold;
      white-space: nowrap;
    }

    .details-btn {
      background: #f0edeb;
      color: #444;
    }

    .block-btn {
      background: #ffe1df;
      color: #c92d2d;
    }

    .unblock-btn {
      background: #d8f8eb;
      color: #00875c;
    }

    .block-btn:hover {
      background: #ffc9c5;
    }

    .unblock-btn:hover {
      background: #b8efd9;
    }

    /* USER DETAILS */

    .details-row {
      display: none;
      background: #faf8f7;
    }

    .details-row td {
      padding: 14px 20px;
      line-height: 1.8;
      color: #666;
    }

    .empty {
      text-align: center;
      padding: 45px;
      color: #888;
    }

    /* PAGINATION */

    .pagination {
      padding: 18px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      flex-wrap: wrap;
      border-top: 1px solid #eee;
    }

    .pagination-info {
      font-size: 10px;
      color: #777;
    }

    .page-links {
      display: flex;
      gap: 5px;
      align-items: center;
    }

    .page-links a,
    .page-links span {
      padding: 8px 11px;
      border-radius: 4px;
      font-size: 11px;
      text-decoration: none;
      color: #555;
      background: #f5f3f2;
    }

    .page-links .current {
      background: #ff6900;
      color: #fff;
    }

    .page-links .disabled {
      opacity: .4;
    }

    /* CUSTOM CONFIRMATION POPUP */

    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(20, 20, 20, 0.55);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      padding: 15px;
      backdrop-filter: blur(3px);
    }

    .modal-overlay.show {
      display: flex;
    }

    .confirm-modal {
      background: #fff;
      width: 100%;
      max-width: 400px;
      padding: 30px;
      border-radius: 12px;
      text-align: center;
      box-shadow: 0 20px 60px rgba(0,0,0,0.2);
      animation: modalOpen .25s ease;
    }

    @keyframes modalOpen {
      from {
        opacity: 0;
        transform: translateY(15px) scale(.96);
      }

      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .modal-icon {
      width: 58px;
      height: 58px;
      border-radius: 50%;
      background: #fff0e5;
      color: #ff6900;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 27px;
      font-weight: bold;
      margin: 0 auto 18px;
    }

    .modal-icon.unblock {
      background: #d8f8eb;
      color: #00875c;
    }

    .confirm-modal h2 {
      font-size: 20px;
      margin-bottom: 10px;
    }

    .confirm-modal p {
      font-size: 12px;
      line-height: 1.7;
      color: #777;
      margin-bottom: 25px;
    }

    .confirm-modal p strong {
      color: #333;
    }

    .modal-actions {
      display: flex;
      gap: 10px;
    }

    .modal-actions button {
      flex: 1;
      padding: 12px;
      border-radius: 6px;
      border: none;
      cursor: pointer;
      font-size: 12px;
      font-weight: bold;
    }

    .cancel-btn {
      background: #f0eeee;
      color: #555;
    }

    .confirm-block-btn {
      background: #ff6900;
      color: white;
    }

    .confirm-unblock-btn {
      background: #00875c;
      color: white;
    }

    .modal-actions button:disabled {
      opacity: .6;
      cursor: not-allowed;
    }

    body.modal-open {
      overflow: hidden;
    }

    /* RESPONSIVE */

    @media (max-width: 1000px) {
      .heading {
        align-items: flex-start;
        flex-direction: column;
      }

      .toolbar {
        flex-wrap: wrap;
      }

      .export-btn {
        margin-left: auto;
      }
    }

    @media (max-width: 650px) {
      .sidebar {
        width: 145px;
      }

      .logo {
        padding: 18px 12px;
        font-size: 16px;
      }

      .nav-links {
        padding: 10px 7px;
      }

      .nav-links a {
        justify-content: flex-start;
        padding: 10px 8px;
        font-size: 11px;
        line-height: 1.3;
        overflow-wrap: anywhere;
      }

      .sidebar-logout-form {
        padding: 8px 7px;
      }

      .signout {
        justify-content: flex-start;
        padding: 10px 8px;
        gap: 7px;
        font-size: 11px;
      }

      .signout span {
        font-size: 14px;
      }

      .main {
        margin-left: 145px;
      }

      .topbar {
        min-height: 70px;
        height: auto;
        padding: 10px;
        gap: 8px;
      }

      .global-search {
        width: 52%;
        min-width: 0;
        font-size: 10px;
      }

      .admin-info {
        min-width: 0;
        font-size: 10px;
        overflow-wrap: anywhere;
      }

      .admin-info span {
        display: inline-block;
        max-width: 120px;
        overflow-wrap: anywhere;
      }

      .content {
        padding: 14px 10px;
      }

      .breadcrumb {
        line-height: 1.6;
      }

      .heading {
        gap: 14px;
        margin-bottom: 18px;
      }

      .heading h1 {
        font-size: 23px;
      }

      .heading p {
        line-height: 1.5;
      }

      .summary {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr;
        gap: 8px;
      }

      .summary-card {
        padding: 10px 12px;
      }

      .toolbar {
        padding: 12px;
        align-items: stretch;
      }

      .search-form {
        width: 100%;
        flex-wrap: wrap;
      }

      .search-input {
        flex-basis: 100%;
        min-width: 0;
      }

      .search-btn,
      .clear-btn {
        flex: 0 0 auto;
      }

      .export-btn {
        margin-left: 0;
        align-self: flex-start;
      }

      .table-wrapper {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }

      table {
        min-width: 850px;
      }

      .pagination {
        padding: 14px 12px;
      }

      .pagination-info {
        width: 100%;
      }

      .page-links {
        flex-wrap: wrap;
      }

      .confirm-modal {
        padding: 22px;
      }
    }

    @media (max-width: 380px) {
      .sidebar {
        width: 125px;
      }

      .main {
        margin-left: 125px;
      }

      .logo {
        font-size: 14px;
      }

      .nav-links a {
        font-size: 10px;
        padding: 9px 6px;
      }

      .global-search {
        width: 48%;
      }

      .admin-info span {
        max-width: 95px;
      }
    }
  </style>
</head>

<body>

  <!-- SIDEBAR -->

  <aside class="sidebar">

    <div class="logo">
      NORIX <span>// ADMIN</span>
    </div>

    <nav class="nav-links">
      <a href="/admin/dashboard">▦ Dashboard</a>
      <a href="#">🎮 Products</a>
      <a href="#">▤ Orders</a>
      <a href="/admin/users" class="active">♙ Users</a>
      <a href="#">▧ Categories</a>
      <a href="#">▤ Coupons</a>
      <a href="#">⚑ Banners</a>
      <a href="#">▥ Sales Report</a>
      <a href="#">◇ Offers</a>
      <a href="#">⚙ Settings</a>
    </nav>

   <form action="/admin/logout" method="POST" class="sidebar-logout-form">
  <button type="submit" class="signout">
    <span>⇥</span> Sign Out
  </button>
</form>

  </aside>

  <!-- MAIN CONTENT -->

  <main class="main">

    <header class="topbar">

      <input
        type="search"
        class="global-search"
        placeholder="⌕ Search admin, orders, SKUs..."
      >

      <div class="admin-info">
        <strong>Superadmin</strong>
        <span><%= admin.email %></span>
      </div>

    </header>

    <section class="content">

      <div class="breadcrumb">
        DIRECTORY // DATABASE <span style="color:#ff6900;">●</span>
        Live System Feed
      </div>

      <div class="heading">

        <div>
          <h1>Users</h1>
          <p>Manage registered customers, account status, and store permissions.</p>
        </div>

        <div class="summary">

          <div class="summary-card">
            <span class="dot total-dot"></span>
            Total:
            <strong><%= totalUsers %></strong>
          </div>

          <div class="summary-card">
            <span class="dot active-dot"></span>
            Active:
            <strong><%= users.filter(user => !user.isBlocked).length %></strong>
          </div>

          <div class="summary-card">
            <span class="dot blocked-dot"></span>
            Blocked:
            <strong><%= users.filter(user => user.isBlocked).length %></strong>
          </div>

        </div>

      </div>

      <!-- USER TABLE -->

      <section class="user-panel">

        <div class="toolbar">

          <form action="/admin/users" method="GET" class="search-form">

            <input
              type="search"
              name="search"
              class="search-input"
              value="<%= search %>"
              placeholder="⌕ Search users by name, email, phone..."
            >

            <button type="submit" class="search-btn">
              Search
            </button>

            <% if (search) { %>
              <a href="/admin/users" class="clear-btn">Clear</a>
            <% } %>

          </form>

          <button type="button" class="export-btn" id="exportCsv">
            ↓ Export CSV
          </button>

        </div>

        <div class="table-wrapper">

          <table id="usersTable">

            <thead>
              <tr>
                <th>USER</th>
                <th>PHONE NUMBER</th>
                <th>REGISTERED</th>
                <th>STATUS</th>
                <th>VERIFICATION</th>
                <th>ACTIONS</th>
              </tr>
            </thead>

            <tbody>

              <% if (users.length > 0) { %>

                <% users.forEach((user, index) => { %>

                  <tr>

                    <td>
                      <div class="user-cell">

                        <div class="avatar">
                          <%= (user.name || 'U').split(' ').map(part => part[0]).join('').substring(0, 2).toUpperCase() %>
                        </div>

                        <div>
                          <div class="user-name"><%= user.name %></div>
                          <div class="user-email"><%= user.email %></div>
                        </div>

                      </div>
                    </td>

                    <td>
                      <%= user.phone || 'Not provided' %>
                    </td>

                    <td class="date-text">
                      <%= new Date(user.createdAt).toLocaleDateString('en-IN', {
                        day: '2-digit',
                        month: 'short',
                        year: 'numeric'
                      }) %>
                    </td>

                    <td>
                      <% if (user.isBlocked) { %>
                        <span class="status blocked-status">● Blocked</span>
                      <% } else { %>
                        <span class="status active-status">● Active</span>
                      <% } %>
                    </td>

                    <td>
                      <% if (user.isVerified) { %>
                        <span class="status active-status">Verified</span>
                      <% } else { %>
                        <span class="status unverified-status">Unverified</span>
                      <% } %>
                    </td>

                    <!-- ACTION BUTTONS -->

                    <td>
                      <div class="action-buttons">

                        <button
                          type="button"
                          class="details-btn"
                          onclick="toggleDetails('<%= index %>')">
                          View Details
                        </button>

                        <button
                          type="button"
                          class="<%= user.isBlocked ? 'unblock-btn' : 'block-btn' %>"
                          data-user-id="<%= user._id %>"
                          data-user-name="<%= user.name %>"
                          data-blocked="<%= user.isBlocked %>"
                          onclick="openStatusModal(this)">

                          <%= user.isBlocked ? 'Unblock' : 'Block' %>

                        </button>

                      </div>
                    </td>

                  </tr>

                  <!-- EXPANDED DETAILS -->

                  <tr class="details-row" id="details-<%= index %>">

                    <td colspan="6">

                      <strong>Customer details</strong><br>

                      Name: <%= user.name %><br>
                      Email: <%= user.email %><br>
                      Phone: <%= user.phone || 'Not provided' %><br>

                      Registered:
                      <%= new Date(user.createdAt).toLocaleString('en-IN') %><br>

                      Account status:
                      <%= user.isBlocked ? 'Blocked' : 'Active' %>

                    </td>

                  </tr>

                <% }) %>

              <% } else { %>

                <tr>
                  <td colspan="6" class="empty">
                    No users found.
                  </td>
                </tr>

              <% } %>

            </tbody>

          </table>

        </div>

        <!-- PAGINATION -->

        <div class="pagination">

          <div class="pagination-info">
            Showing <strong><%= users.length %></strong>
            of <strong><%= totalUsers %></strong> customers
          </div>

          <div class="page-links">

            <% if (currentPage > 1) { %>
              <a href="/admin/users?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(search) %>">‹</a>
            <% } else { %>
              <span class="disabled">‹</span>
            <% } %>

            <% for (let i = 1; i <= totalPages; i++) { %>

              <% if (
                i === 1 ||
                i === totalPages ||
                Math.abs(i - currentPage) <= 1
              ) { %>

                <% if (i === currentPage) { %>
                  <span class="current"><%= i %></span>
                <% } else { %>
                  <a href="/admin/users?page=<%= i %>&search=<%= encodeURIComponent(search) %>">
                    <%= i %>
                  </a>
                <% } %>

              <% } else if (
                i === currentPage - 2 ||
                i === currentPage + 2
              ) { %>

                <span>...</span>

              <% } %>

            <% } %>

            <% if (currentPage < totalPages) { %>
              <a href="/admin/users?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(search) %>">›</a>
            <% } else { %>
              <span class="disabled">›</span>
            <% } %>

          </div>

        </div>

      </section>

    </section>

  </main>

  <!-- CUSTOM BLOCK / UNBLOCK MODAL -->

  <div class="modal-overlay" id="statusModal">

    <div
      class="confirm-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modalTitle"
      aria-describedby="modalMessage">

      <div class="modal-icon" id="modalIcon">!</div>

      <h2 id="modalTitle">Block Customer?</h2>

      <p id="modalMessage">
        Are you sure you want to block this customer?
      </p>

      <form id="statusForm" method="POST">

        <input
          type="hidden"
          name="page"
          value="<%= currentPage %>"
        >

        <input
          type="hidden"
          name="search"
          value="<%= search %>"
        >

        <div class="modal-actions">

          <button
            type="button"
            class="cancel-btn"
            id="cancelModal">
            Cancel
          </button>

          <button
            type="submit"
            class="confirm-block-btn"
            id="confirmStatusBtn">
            Block User
          </button>

        </div>

      </form>

    </div>

  </div>

  <script>

    // VIEW USER DETAILS

    function toggleDetails(index) {

      const row = document.getElementById(`details-${index}`);

      row.style.display =
        row.style.display === 'table-row'
          ? 'none'
          : 'table-row';

    }


    // CUSTOM BLOCK / UNBLOCK POPUP

    const statusModal = document.getElementById('statusModal');

    const statusForm = document.getElementById('statusForm');

    const modalIcon = document.getElementById('modalIcon');

    const modalTitle = document.getElementById('modalTitle');

    const modalMessage = document.getElementById('modalMessage');

    const confirmStatusBtn = document.getElementById('confirmStatusBtn');

    const cancelModal = document.getElementById('cancelModal');


    function openStatusModal(button) {

      const userId = button.dataset.userId;

      const userName = button.dataset.userName;

      const isBlocked = button.dataset.blocked === 'true';

      // Set backend form URL

      statusForm.action =
        `/admin/users/${encodeURIComponent(userId)}/toggle-status`;


      // Set popup content

      modalTitle.textContent =
        isBlocked ? 'Unblock Customer?' : 'Block Customer?';

      modalIcon.textContent =
        isBlocked ? '✓' : '!';

      modalIcon.className =
        isBlocked ? 'modal-icon unblock' : 'modal-icon';


      // Safely display customer name

      modalMessage.replaceChildren();

      const messageText = document.createTextNode(
        isBlocked
          ? 'Are you sure you want to unblock '
          : 'Are you sure you want to block '
      );

      const customerName = document.createElement('strong');

      customerName.textContent = userName;

      const endingText = document.createTextNode(
        isBlocked
          ? '? They will regain access to their account.'
          : '? They will lose access to their account.'
      );

      modalMessage.append(
        messageText,
        customerName,
        endingText
      );


      // Change confirmation button

      confirmStatusBtn.textContent =
        isBlocked ? 'Unblock User' : 'Block User';

      confirmStatusBtn.className =
        isBlocked
          ? 'confirm-unblock-btn'
          : 'confirm-block-btn';


      // Open popup

      statusModal.classList.add('show');

      document.body.classList.add('modal-open');

      cancelModal.focus();

    }


    // CLOSE POPUP

    function closeStatusModal() {

      statusModal.classList.remove('show');

      document.body.classList.remove('modal-open');

    }


    cancelModal.addEventListener('click', closeStatusModal);


    // CLOSE WHEN CLICKING OUTSIDE POPUP

    statusModal.addEventListener('click', function(event) {

      if (event.target === statusModal) {

        closeStatusModal();

      }

    });


    // CLOSE USING ESCAPE KEY

    document.addEventListener('keydown', function(event) {

      if (
        event.key === 'Escape' &&
        statusModal.classList.contains('show')
      ) {

        closeStatusModal();

      }

    });


    // PREVENT DOUBLE SUBMISSION

    statusForm.addEventListener('submit', function() {

      confirmStatusBtn.disabled = true;

      confirmStatusBtn.textContent = 'Processing...';

    });


    // EXPORT CURRENT PAGE USERS AS CSV

    document.getElementById('exportCsv').addEventListener('click', () => {

      const rows = [
        [
          'Name',
          'Email',
          'Phone',
          'Registration Date',
          'Status',
          'Verification'
        ]
      ];

      <% users.forEach(user => { %>

        rows.push([

          <%- JSON.stringify(user.name || '') %>,

          <%- JSON.stringify(user.email || '') %>,

          <%- JSON.stringify(user.phone || '') %>,

          <%- JSON.stringify(new Date(user.createdAt).toLocaleDateString('en-IN')) %>,

          <%- JSON.stringify(user.isBlocked ? 'Blocked' : 'Active') %>,

          <%- JSON.stringify(user.isVerified ? 'Verified' : 'Unverified') %>

        ]);

      <% }) %>


      const csv = rows.map(row =>

        row.map(value =>

          '"' + String(value).replace(/"/g, '""') + '"'

        ).join(',')

      ).join('\n');


      const blob = new Blob([csv], {

        type: 'text/csv;charset=utf-8;'

      });


      const url = URL.createObjectURL(blob);

      const link = document.createElement('a');

      link.href = url;

      link.download = 'norix-users.csv';

      link.click();

      URL.revokeObjectURL(url);

    });

  </script>

</body>
</html>
