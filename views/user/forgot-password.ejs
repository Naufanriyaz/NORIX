
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password | NORIX</title>
  <link rel="stylesheet" href="/css/norix.css">

  <style>
    .recovery-page {
      min-height: 100vh;
      background: #f5f3f2;
      font-family: Arial, sans-serif;
    }

    .recovery-header {
      height: 60px;
      padding: 0 5%;
      background: #fff;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .recovery-logo {
      color: #222;
      font-size: 22px;
      font-weight: 800;
      text-decoration: none;
    }

    .recovery-logo span {
      color: #ff6500;
    }

    .recovery-return {
      color: #ff6500;
      font-size: 11px;
      font-weight: bold;
      text-decoration: none;
    }

    .recovery-card {
      width: 90%;
      max-width: 1050px;
      margin: 55px auto;
      background: #fff;
      display: grid;
      grid-template-columns: 1fr 1fr;
      border-radius: 5px;
      overflow: hidden;
      box-shadow: 0 5px 20px rgba(0,0,0,.08);
    }

    .recovery-promo {
      background: linear-gradient(140deg, #171717, #35302d);
      color: #fff;
      padding: 45px 38px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .recovery-label {
      color: #ff790f;
      font-size: 10px;
      font-weight: bold;
      letter-spacing: 1px;
    }

    .recovery-promo h1 {
      font-size: 29px;
      line-height: 1.2;
      margin: 20px 0 14px;
    }

    .recovery-promo h1 span {
      color: #ff790f;
    }

    .recovery-promo p {
      color: #ccc;
      font-size: 13px;
      line-height: 1.7;
    }

    .recovery-benefits {
      list-style: none;
      padding: 0;
      margin-top: 30px;
    }

    .recovery-benefits li {
      color: #ddd;
      font-size: 12px;
      margin: 18px 0;
      line-height: 1.6;
    }

    .recovery-benefits li::before {
      content: "✓";
      color: #ff790f;
      font-weight: bold;
      margin-right: 10px;
    }

    .recovery-promo-footer {
      color: #aaa;
      font-size: 10px;
      margin-top: 35px;
    }

    .recovery-form-panel {
      padding: 55px 45px;
      display: flex;
      align-items: center;
    }

    .recovery-form-container {
      width: 100%;
      max-width: 390px;
      margin: auto;
    }

    .recovery-step {
      color: #ff6500;
      font-size: 10px;
      font-weight: bold;
      letter-spacing: 1px;
    }

    .recovery-form-container h2 {
      font-size: 25px;
      margin: 15px 0 10px;
      color: #222;
    }

    .recovery-description {
      font-size: 12px;
      color: #777;
      line-height: 1.7;
      margin-bottom: 30px;
    }

    .recovery-field {
      margin-bottom: 22px;
    }

    .recovery-field label {
      display: block;
      font-size: 11px;
      font-weight: bold;
      letter-spacing: .6px;
      margin-bottom: 10px;
    }

    .recovery-field label span {
      color: #ff6500;
    }

    .recovery-field input {
      width: 100%;
      box-sizing: border-box;
      padding: 14px;
      border: 1px solid #ddd;
      border-radius: 3px;
      outline: none;
      font-size: 13px;
    }

    .recovery-field input:focus {
      border-color: #ff6500;
    }

    .recovery-submit {
      width: 100%;
      background: #ff6500;
      color: #fff;
      border: none;
      padding: 15px;
      font-size: 11px;
      font-weight: bold;
      cursor: pointer;
      border-radius: 3px;
    }

    .recovery-submit:hover {
      background: #e85b00;
    }

    .recovery-back {
      text-align: center;
      margin-top: 22px;
      font-size: 12px;
      color: #777;
    }

    .recovery-back a {
      color: #ff6500;
      font-weight: bold;
      text-decoration: none;
    }

    .recovery-security {
      text-align: center;
      color: #999;
      font-size: 9px;
      margin-top: 35px;
    }

    /* POPUP */

    .norix-popup-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.65);
      display: none;
      justify-content: center;
      align-items: center;
      padding: 20px;
      z-index: 99999;
      box-sizing: border-box;
    }

    .norix-popup {
      width: 100%;
      max-width: 430px;
      padding: 34px 30px;
      background: #fff;
      border-radius: 11px;
      text-align: center;
      box-sizing: border-box;
    }

    .norix-popup-icon {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: #fff0f0;
      color: #d62828;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
      font-weight: bold;
      margin: 0 auto 20px;
    }

    .norix-popup h3 {
      margin-bottom: 12px;
      color: #222;
    }

    .norix-popup p {
      color: #666;
      font-size: 14px;
      line-height: 1.6;
    }

    .norix-popup button {
      margin-top: 24px;
      padding: 13px 40px;
      background: #222;
      color: #fff;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }

    @media(max-width: 750px) {
      .recovery-card {
        grid-template-columns: 1fr;
        margin: 25px auto;
      }

      .recovery-promo {
        padding: 30px 25px;
      }

      .recovery-promo h1 {
        font-size: 24px;
      }

      .recovery-form-panel {
        padding: 35px 25px;
      }
    }
  </style>
</head>

<body>

<div class="recovery-page">

  <header class="recovery-header">
    <a href="/" class="recovery-logo">NORIX<span>.</span></a>
    <a href="/" class="recovery-return">RETURN TO STORE →</a>
  </header>

  <main class="recovery-card">

    <!-- LEFT PROMOTIONAL PANEL -->

    <section class="recovery-promo">

      <div>
        <span class="recovery-label">● NORIX ACCOUNT SECURITY</span>

        <h1>
          SECURE YOUR
          <span>ACCOUNT.</span>
        </h1>

        <p>
          Forgot your password? No worries.
          We'll help you recover your account and get
          back to your gaming experience.
        </p>

        <ul class="recovery-benefits">
          <li>Secure email verification process</li>
          <li>One-time password verification</li>
          <li>Protected account recovery</li>
          <li>Quick and simple password reset</li>
        </ul>
      </div>

      <div class="recovery-promo-footer">
        ● 256-BIT SSL ENCRYPTED
      </div>

    </section>

    <!-- RIGHT FORM PANEL -->

    <section class="recovery-form-panel">

      <div class="recovery-form-container">

        <span class="recovery-step">ACCOUNT RECOVERY</span>

        <h2>Forgot Password?</h2>

        <p class="recovery-description">
          Enter your registered email address.
          We'll send you an OTP to verify your identity
          and reset your password.
        </p>

        <form
          action="/forgot-password"
          method="POST"
          id="forgotForm"
          novalidate
        >

          <div class="recovery-field">

            <label for="email">
              EMAIL ADDRESS <span>*</span>
            </label>

            <input
              type="email"
              id="email"
              name="email"
              placeholder="Enter your registered email"
              autocomplete="email"
            >

          </div>

          <button type="submit" class="recovery-submit">
            SEND RESET LINK →
          </button>

        </form>

        <div class="recovery-back">
          Remember your password?
          <a href="/login">BACK TO LOGIN</a>
        </div>

        <div class="recovery-security">
          ♢ SECURE ACCOUNT RECOVERY · NORIX SECURITY
        </div>

      </div>

    </section>

  </main>

</div>

<!-- CUSTOM POPUP -->

<div class="norix-popup-overlay" id="forgotPopup"
  role="dialog" aria-modal="true" aria-labelledby="forgotPopupTitle">

  <div class="norix-popup">
    <div class="norix-popup-icon">!</div>
    <h3 id="forgotPopupTitle">Recovery Error</h3>
    <p id="forgotPopupMessage"></p>
    <button type="button" id="forgotPopupClose">OK</button>
  </div>

</div>

<script>
  const forgotForm = document.getElementById('forgotForm');
  const emailInput = document.getElementById('email');

  const popup = document.getElementById('forgotPopup');
  const popupTitle = document.getElementById('forgotPopupTitle');
  const popupMessage = document.getElementById('forgotPopupMessage');
  const popupClose = document.getElementById('forgotPopupClose');

  function showPopup(title, message) {
    popupTitle.textContent = title;
    popupMessage.textContent = message;
    popup.style.display = 'flex';
    popupClose.focus();
  }

  function closePopup() {
    popup.style.display = 'none';
  }

  popupClose.addEventListener('click', closePopup);

  popup.addEventListener('click', (event) => {
    if (event.target === popup) closePopup();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closePopup();
  });

  // Display backend error safely
  const serverError = <%- JSON.stringify(error || null) %>;

  if (serverError) {
    showPopup('Recovery Failed', serverError);
  }

  forgotForm.addEventListener('submit', (event) => {
    event.preventDefault();

    const email = emailInput.value.trim();

    if (!email) {
      showPopup('Missing Information', 'Please enter your email address.');
      emailInput.focus();
      return;
    }

    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    if (!emailPattern.test(email)) {
      showPopup('Invalid Email', 'Please enter a valid email address.');
      emailInput.focus();
      return;
    }

    HTMLFormElement.prototype.submit.call(forgotForm);
  });
</script>

</body>
</html>
