
<%- include('../partials/head', { title: title }) %>
<%- include('../partials/header', { currentPage: 'addresses' }) %>

<style>
    /* MAIN PAGE */

    .addresses-page {
        max-width: 1100px;
        margin: 55px auto;
        padding: 0 24px;
        min-height: 450px;
    }

    .addresses-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .addresses-heading h1 {
        font-size: 30px;
        font-weight: 800;
        margin: 8px 0;
        color: #222;
    }

    .addresses-heading p {
        color: #777;
        font-size: 14px;
    }

    .address-eyebrow {
        color: #ff6900;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .add-address-btn {
        background: #ff6900;
        color: white;
        text-decoration: none;
        padding: 13px 20px;
        border-radius: 5px;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
        border: none;
        cursor: pointer;
    }

    .add-address-btn:hover {
        background: #e65e00;
        color: white;
    }

    /* ADDRESS GRID */

    .addresses-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .address-card {
        background: #fff;
        border: 1px solid #eaeaea;
        border-radius: 10px;
        padding: 24px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, .035);
    }

    .address-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 15px;
    }

    .address-name {
        font-size: 17px;
        font-weight: 700;
        color: #222;
    }

    .address-badges {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
    }

    .address-type-badge,
    .default-badge {
        font-size: 10px;
        font-weight: 700;
        padding: 6px 9px;
        border-radius: 3px;
    }

    .address-type-badge {
        background: #f2f2f2;
        color: #555;
    }

    .default-badge {
        background: #fff0e5;
        color: #ff6900;
    }

    /* ADDRESS DETAILS */

    .address-details {
        color: #666;
        font-size: 13px;
        line-height: 1.9;
    }

    .address-details p {
        margin: 0;
    }

    .address-phone {
        margin-top: 10px !important;
        color: #333;
        font-weight: 600;
    }

    /* ADDRESS ACTIONS */

    .address-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        border-top: 1px solid #eee;
        margin-top: 20px;
        padding-top: 16px;
    }

    .address-action {
        border: 1px solid #ddd;
        background: white;
        color: #444;
        padding: 9px 13px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
    }

    .address-action:hover {
        border-color: #ff6900;
        color: #ff6900;
    }

    .delete-action {
        color: #d93636;
    }

    .default-action {
        color: #ff6900;
        margin-left: auto;
    }

    .address-actions form {
        margin: 0;
    }

    /* EMPTY ADDRESS */

    .empty-addresses {
        grid-column: 1 / -1;
        text-align: center;
        background: #fff;
        border: 1px solid #eee;
        border-radius: 10px;
        padding: 65px 20px;
    }

    .empty-addresses h3 {
        color: #222;
        margin-bottom: 10px;
    }

    .empty-addresses p {
        color: #777;
        font-size: 13px;
        margin-bottom: 22px;
    }

    /* DELETE CONFIRMATION POPUP */

    .delete-popup-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.65);
        z-index: 9999;
        justify-content: center;
        align-items: center;
        padding: 20px;
        box-sizing: border-box;
    }

    .delete-popup {
        background: #fff;
        width: 100%;
        max-width: 380px;
        padding: 30px;
        border-radius: 10px;
        text-align: center;
        box-sizing: border-box;
        animation: popupAppear 0.2s ease;
    }

    .delete-popup-icon {
        width: 45px;
        height: 45px;
        background: #fff0e5;
        color: #ff6900;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: bold;
        margin: 0 auto 15px;
    }

    .delete-popup h3 {
        color: #222;
        margin-bottom: 10px;
    }

    .delete-popup p {
        color: #777;
        font-size: 14px;
        line-height: 1.6;
    }

    .delete-popup-actions {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-top: 25px;
    }

    .delete-popup-actions button {
        padding: 12px 16px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-weight: 700;
        font-size: 11px;
    }

    #cancelDelete {
        background: #eee;
        color: #222;
    }

    #confirmDelete {
        background: #ff6900;
        color: #fff;
    }

    #confirmDelete:hover {
        background: #e65e00;
    }

    @keyframes popupAppear {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* RESPONSIVE */

    @media (max-width: 700px) {
        .addresses-grid {
            grid-template-columns: 1fr;
        }

        .addresses-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .addresses-heading h1 {
            font-size: 25px;
        }

        .address-card-top {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    @media (max-width: 450px) {
        .addresses-page {
            padding: 0 15px;
        }

        .address-card {
            padding: 18px;
        }

        .address-actions {
            gap: 8px;
        }

        .default-action {
            margin-left: 0;
        }

        .delete-popup-actions {
            flex-direction: column;
        }
    }
</style>

<main class="addresses-page">

    <!-- PAGE HEADING -->

    <div class="addresses-heading">

        <div>
            <span class="address-eyebrow">
                ● SHIPPING & DELIVERY
            </span>

            <h1>MY ADDRESSES</h1>

            <p>
                Manage your saved delivery destinations for your NORIX orders.
            </p>
        </div>

        <a href="/addresses/new" class="add-address-btn">
            + ADD NEW ADDRESS
        </a>

    </div>

    <!-- ADDRESS LIST -->

    <div class="addresses-grid">

        <% if (user.addresses && user.addresses.length > 0) { %>

            <% user.addresses.forEach(address => { %>

                <div class="address-card">

                    <div class="address-card-top">

                        <div class="address-name">
                            <%= address.fullName %>
                        </div>

                        <div class="address-badges">

                            <span class="address-type-badge">
                                <%= address.addressType %>
                            </span>

                            <% if (address.isDefault) { %>

                                <span class="default-badge">
                                    DEFAULT
                                </span>

                            <% } %>

                        </div>

                    </div>

                    <!-- ADDRESS DETAILS -->

                    <div class="address-details">

                        <p><%= address.house %></p>

                        <p><%= address.street %></p>

                        <p>
                            <%= address.city %>,
                            <%= address.state %> -
                            <%= address.pincode %>
                        </p>

                        <% if (address.landmark) { %>

                            <p>
                                Landmark: <%= address.landmark %>
                            </p>

                        <% } %>

                        <p class="address-phone">
                            Phone: <%= address.phone %>
                        </p>

                    </div>

                    <!-- ADDRESS ACTIONS -->

                    <div class="address-actions">

                        <a
                            href="/addresses/<%= address._id %>/edit"
                            class="address-action">

                            EDIT

                        </a>

                        <form
                            action="/addresses/<%= address._id %>/delete"
                            method="POST"
                            class="delete-address-form">

                            <button
                                type="submit"
                                class="address-action delete-action">

                                DELETE

                            </button>

                        </form>

                        <% if (!address.isDefault) { %>

                            <form
                                action="/addresses/<%= address._id %>/default"
                                method="POST">

                                <button
                                    type="submit"
                                    class="address-action default-action">

                                    SET AS DEFAULT

                                </button>

                            </form>

                        <% } %>

                    </div>

                </div>

            <% }) %>

        <% } else { %>

            <!-- EMPTY STATE -->

            <div class="empty-addresses">

                <h3>No saved addresses yet</h3>

                <p>
                    Add your first delivery address to make checkout faster.
                </p>

                <a href="/addresses/new" class="add-address-btn">
                    + ADD YOUR FIRST ADDRESS
                </a>

            </div>

        <% } %>

    </div>

</main>

<!-- CUSTOM DELETE POPUP -->

<div
    class="delete-popup-overlay"
    id="deletePopup"
    role="dialog"
    aria-modal="true"
    aria-labelledby="deletePopupTitle">

    <div class="delete-popup">

        <div class="delete-popup-icon">
            !
        </div>

        <h3 id="deletePopupTitle">
            Delete Address?
        </h3>

        <p>
            Are you sure you want to delete this saved address?
            This action cannot be undone.
        </p>

        <div class="delete-popup-actions">

            <button type="button" id="cancelDelete">
                CANCEL
            </button>

            <button type="button" id="confirmDelete">
                YES, DELETE
            </button>

        </div>

    </div>

</div>

<script>
    // DELETE POPUP ELEMENTS

    const deletePopup = document.getElementById('deletePopup');

    const cancelDelete = document.getElementById('cancelDelete');

    const confirmDelete = document.getElementById('confirmDelete');

    let selectedDeleteForm = null;


    // OPEN POPUP

    document.querySelectorAll('.delete-address-form').forEach(form => {

        form.addEventListener('submit', event => {

            event.preventDefault();

            selectedDeleteForm = form;

            deletePopup.style.display = 'flex';

            cancelDelete.focus();

        });

    });


    // CANCEL DELETE

    cancelDelete.addEventListener('click', () => {

        deletePopup.style.display = 'none';

        selectedDeleteForm = null;

    });


    // CONFIRM DELETE

    confirmDelete.addEventListener('click', () => {

        if (selectedDeleteForm) {

            selectedDeleteForm.submit();

        }

    });


    // CLOSE WHEN CLICKING OUTSIDE POPUP

    deletePopup.addEventListener('click', event => {

        if (event.target === deletePopup) {

            deletePopup.style.display = 'none';

            selectedDeleteForm = null;

        }

    });


    // CLOSE USING ESCAPE KEY

    document.addEventListener('keydown', event => {

        if (event.key === 'Escape' && deletePopup.style.display === 'flex') {

            deletePopup.style.display = 'none';

            selectedDeleteForm = null;

        }

    });

</script>

<%- include('../partials/footer') %>
