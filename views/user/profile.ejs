
<%- include('../partials/head', { title: 'NORIX | My Profile' }) %>
<%- include('../partials/header', { currentPage: 'profile' }) %>

<main class="profile-page">

  <!-- PAGE HEADING -->
  <section class="profile-heading">
    <div class="profile-breadcrumb">
      <a href="/">HOME</a> / MY ACCOUNT
    </div>
    <h1>MY ACCOUNT</h1>
    <p>Manage your personal details and saved addresses.</p>
  </section>

  <div class="profile-layout">

    <!-- SIDEBAR -->
    <aside class="profile-sidebar">

      <div class="profile-user-card">

        <% if (user.profileImage) { %>
          <img
            src="<%= user.profileImage %>"
            alt="Profile picture"
            class="profile-avatar"
          >
        <% } else { %>
          <div class="profile-avatar">
            <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
          </div>
        <% } %>

        <h3><%= user.name %></h3>
        <p><%= user.email %></p>

        <span>
          MEMBER SINCE <%= new Date(user.createdAt).getFullYear() %>
        </span>

      </div>

      <nav class="account-nav">

        <a href="/profile" class="active">
          <span>♙</span> My Profile
        </a>

        <a href="/orders">
          <span>▤</span> My Orders
        </a>

        <a href="/addresses">
          <span>⌖</span> Saved Addresses
        </a>

        <a href="/wishlist">
          <span>♡</span> Wishlist
          <small>0</small>
        </a>

        <a href="/wallet">
          <span>▣</span> My Wallet
        </a>

        <a href="/coupons">
          <span>％</span> My Coupons
        </a>

        <a href="/referral">
          <span>♧</span> Refer & Earn
        </a>

        <!-- CUSTOMER LOGOUT -->
        <form
          action="/logout"
          method="POST"
          id="customerLogoutForm"
          novalidate
        >
          <button
            type="button"
            class="profile-logout"
            id="openLogoutPopup"
          >
            <span>⇥</span> Logout
          </button>
        </form>

      </nav>

    </aside>

    <!-- MAIN CONTENT -->
    <div class="profile-content">

      <!-- PERSONAL INFORMATION -->
      <section class="profile-panel">

        <div class="profile-panel-heading">
          <div>
            <span class="panel-icon">♙</span>
            <div>
              <h2>PERSONAL INFORMATION</h2>
              <p>Update your personal details and account information.</p>
            </div>
          </div>
        </div>

        <div class="personal-info-grid">

          <div class="info-item">
            <span>FULL NAME</span>
            <strong><%= user.name %></strong>
          </div>

          <div class="info-item">
            <span>EMAIL ADDRESS</span>
            <strong><%= user.email %></strong>
          </div>

          <div class="info-item">
            <span>PHONE NUMBER</span>
            <strong><%= user.phone || 'Not added' %></strong>
          </div>

        </div>

        <!-- PROFILE ACTION BUTTONS -->
        <div class="profile-actions">

          <a href="/profile/edit" class="profile-action-btn profile-edit-btn">
            <span>✎</span>
            EDIT PROFILE
          </a>

          <a href="/profile/update-email" class="profile-action-btn profile-email-btn">
            <span>✉</span>
            UPDATE EMAIL
          </a>

          <a href="/change-password" class="profile-action-btn profile-password-btn">
            <span>▤</span>
            CHANGE PASSWORD
          </a>

        </div>

      </section>

      <!-- RECENT ORDERS -->
      <section class="profile-panel">

        <div class="profile-panel-heading order-heading">
          <div>
            <span class="panel-icon">▤</span>
            <div>
              <h2>RECENT ORDERS</h2>
              <p>View your order status, collection records, and return requests.</p>
            </div>
          </div>

          <a href="/orders" class="profile-view-link">
            VIEW ALL ORDERS ↗
          </a>
        </div>

        <div class="profile-empty-state">
          <p>Your recent orders will appear here.</p>
          <a href="/products">START SHOPPING →</a>
        </div>

      </section>

      <!-- SAVED ADDRESSES -->
      <section class="profile-panel">

        <div class="profile-panel-heading">
          <div>
            <span class="panel-icon">⌖</span>
            <div>
              <h2>SAVED ADDRESSES</h2>
              <p>Manage your default shipping and delivery destinations.</p>
            </div>
          </div>
        </div>

        <div class="saved-address-grid">

          <div class="profile-empty-state">
            <p>You haven't added any delivery addresses yet.</p>

            <a href="/addresses/new">
              ADD YOUR FIRST ADDRESS →
            </a>
          </div>

        </div>

      </section>

    </div>

  </div>

  <!-- BENEFITS STRIP -->
  <section class="profile-benefits">

    <div>
      <span>◉</span>
      <div>
        <strong>Zero-Latency Polling</strong>
        <small>8,000Hz tournament-grade</small>
      </div>
    </div>

    <div>
      <span>▣</span>
      <div>
        <strong>Free Express Delivery</strong>
        <small>Fast delivery on eligible orders</small>
      </div>
    </div>

    <div>
      <span>♢</span>
      <div>
        <strong>2-Year NORIX Care</strong>
        <small>Hardware replacement protection</small>
      </div>
    </div>

    <div>
      <span>♙</span>
      <div>
        <strong>Secure Payments</strong>
        <small>UPI, Credit Cards, Netbanking & more</small>
      </div>
    </div>

  </section>

</main>

<!-- PROFILE UPLOAD ERROR POPUP -->
<div
  class="edit-popup-overlay"
  id="editPopup"
  role="dialog"
  aria-modal="true"
  aria-labelledby="editPopupTitle"
  style="display: none;"
>

  <div class="edit-popup">

    <div class="edit-popup-icon">!</div>

    <h3 id="editPopupTitle">Upload Error</h3>

    <p id="editPopupMessage"></p>

    <button type="button" id="editPopupClose">
      OK
    </button>

  </div>

</div>

<!-- CUSTOMER LOGOUT CONFIRMATION POPUP -->
<div
  class="logout-popup-overlay"
  id="logoutPopup"
  role="dialog"
  aria-modal="true"
  aria-labelledby="logoutPopupTitle"
  aria-describedby="logoutPopupMessage"
  style="display: none;"
>

  <div class="logout-popup">

    <div class="logout-popup-icon">⇥</div>

    <h3 id="logoutPopupTitle">LOG OUT?</h3>

    <p id="logoutPopupMessage">
      Are you sure you want to log out of your NORIX account?
    </p>

    <div class="logout-popup-actions">

      <button type="button" id="cancelLogout">
        CANCEL
      </button>

      <button type="button" id="confirmLogout">
        YES, LOG OUT
      </button>

    </div>

  </div>

</div>

<style>

  /* PROFILE ACTION BUTTONS */

  .profile-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 25px;
  }

  .profile-action-btn {
    width: 185px;
    height: 54px;
    padding: 0 12px;
    box-sizing: border-box;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;

    border-radius: 5px;
    font-size: 12px;
    font-weight: 700;
    font-family: inherit;
    text-decoration: none;
    white-space: nowrap;

    cursor: pointer;
    transition: all 0.2s ease;
  }

  /* EDIT PROFILE */

  .profile-edit-btn {
    background: #ff6900;
    color: #fff;
    border: 1px solid #ff6900;
  }

  .profile-edit-btn:hover {
    background: #e85e00;
    border-color: #e85e00;
  }

  /* UPDATE EMAIL */

  .profile-email-btn {
    background: #f1f1f1;
    color: #222;
    border: 1px solid #ddd;
  }

  .profile-email-btn:hover {
    background: #222;
    color: #fff;
    border-color: #222;
  }

  /* CHANGE PASSWORD */

  .profile-password-btn {
    background: #f1f1f1;
    color: #222;
    border: 1px solid #ddd;
  }

  .profile-password-btn:hover {
    background: #222;
    color: #fff;
    border-color: #222;
  }

  /* EXISTING UPLOAD ERROR POPUP */

  .edit-popup-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    z-index: 9999;
    justify-content: center;
    align-items: center;
    padding: 20px;
    box-sizing: border-box;
  }

  .edit-popup {
    background: #fff;
    width: 100%;
    max-width: 380px;
    padding: 30px;
    border-radius: 10px;
    text-align: center;
    box-sizing: border-box;
  }

  .edit-popup-icon {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    background: #fff0f0;
    color: #d62828;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    font-weight: bold;
    margin: 0 auto 15px;
  }

  .edit-popup h3 {
    margin-bottom: 10px;
  }

  .edit-popup p {
    color: #666;
    font-size: 14px;
    line-height: 1.6;
  }

  .edit-popup button {
    margin-top: 20px;
    padding: 12px 35px;
    border: none;
    border-radius: 5px;
    background: #222;
    color: #fff;
    cursor: pointer;
  }

  /* LOGOUT CONFIRMATION POPUP */

  .logout-popup-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    z-index: 10000;
    justify-content: center;
    align-items: center;
    padding: 20px;
    box-sizing: border-box;
  }

  .logout-popup {
    width: 100%;
    max-width: 390px;
    background: #fff;
    border-radius: 10px;
    padding: 32px 25px;
    text-align: center;
    box-sizing: border-box;
    animation: logoutPopupAppear 0.2s ease;
  }

  .logout-popup-icon {
    width: 52px;
    height: 52px;
    margin: 0 auto 17px;
    border-radius: 50%;
    background: #fff0e5;
    color: #ff6900;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 25px;
    font-weight: bold;
  }

  .logout-popup h3 {
    color: #222;
    font-size: 19px;
    font-weight: 800;
    margin: 0 0 12px;
  }

  .logout-popup p {
    color: #777;
    font-size: 14px;
    line-height: 1.7;
    margin: 0;
  }

  .logout-popup-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 26px;
  }

  .logout-popup-actions button {
    min-width: 125px;
    padding: 13px 15px;
    border: none;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 800;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  #cancelLogout {
    background: #eee;
    color: #333;
  }

  #cancelLogout:hover {
    background: #ddd;
  }

  #confirmLogout {
    background: #ff6900;
    color: #fff;
  }

  #confirmLogout:hover {
    background: #e65e00;
  }

  @keyframes logoutPopupAppear {
    from {
      opacity: 0;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* MOBILE RESPONSIVE */

  @media (max-width: 650px) {

    .profile-actions {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .profile-action-btn {
      width: 100%;
      height: 52px;
    }

    .logout-popup {
      padding: 28px 20px;
    }

    .logout-popup-actions {
      flex-direction: column-reverse;
    }

    .logout-popup-actions button {
      width: 100%;
    }

  }

</style>

<script>

  // PROFILE UPLOAD ERROR POPUP

  const editPopup = document.getElementById('editPopup');
  const popupTitle = document.getElementById('editPopupTitle');
  const popupMessage = document.getElementById('editPopupMessage');
  const popupClose = document.getElementById('editPopupClose');

  function showPopup(title, message) {
    popupTitle.textContent = title;
    popupMessage.textContent = message;
    editPopup.style.display = 'flex';
    popupClose.focus();
  }

  function closePopup() {
    editPopup.style.display = 'none';

    window.history.replaceState(
      {},
      document.title,
      window.location.pathname
    );
  }

  popupClose.addEventListener('click', closePopup);

  editPopup.addEventListener('click', (event) => {
    if (event.target === editPopup) {
      closePopup();
    }
  });

  // BACKEND UPLOAD ERROR

  const uploadError = <%- JSON.stringify(
    typeof uploadError !== 'undefined' ? uploadError : null
  ).replace(/</g, '\\u003c') %>;

  if (uploadError) {
    showPopup('Profile Upload Error', uploadError);
  }

  // CUSTOMER LOGOUT CONFIRMATION

  const logoutPopup = document.getElementById('logoutPopup');
  const openLogoutPopup = document.getElementById('openLogoutPopup');
  const cancelLogout = document.getElementById('cancelLogout');
  const confirmLogout = document.getElementById('confirmLogout');
  const customerLogoutForm = document.getElementById('customerLogoutForm');

  function openLogoutConfirmation() {
    logoutPopup.style.display = 'flex';
    cancelLogout.focus();
  }

  function closeLogoutConfirmation() {
    logoutPopup.style.display = 'none';
    openLogoutPopup.focus();
  }

  openLogoutPopup.addEventListener('click', openLogoutConfirmation);

  cancelLogout.addEventListener('click', closeLogoutConfirmation);

  confirmLogout.addEventListener('click', () => {
    customerLogoutForm.submit();
  });

  // CLOSE LOGOUT POPUP WHEN CLICKING OUTSIDE

  logoutPopup.addEventListener('click', (event) => {
    if (event.target === logoutPopup) {
      closeLogoutConfirmation();
    }
  });

  // CLOSE POPUPS USING ESCAPE

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      if (logoutPopup.style.display === 'flex') {
        closeLogoutConfirmation();
      } else if (editPopup.style.display === 'flex') {
        closePopup();
      }
    }
  });

</script>

<%- include('../partials/footer') %>
</body>
</html>
