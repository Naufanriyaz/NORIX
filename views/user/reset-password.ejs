
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password | NORIX</title>
  <link rel="stylesheet" href="/css/norix.css">

  <style>
    .password-popup {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.65);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 9999;
    }

    .password-popup-content {
      background: #fff;
      color: #222;
      padding: 25px;
      border-radius: 12px;
      width: 90%;
      max-width: 350px;
      text-align: center;
    }

    .password-popup-content button {
      padding: 10px 25px;
      cursor: pointer;
    }
  </style>
</head>
<body>

  <div id="passwordPopup" class="password-popup">
    <div class="password-popup-content">
      <h3 id="popupTitle">Password Error</h3>
      <p id="popupMessage"></p>
      <button type="button" id="popupClose">OK</button>
    </div>
  </div>

  <main>
    <h1>Reset Your Password</h1>
    <p>Enter your new password below.</p>

<form action="/reset-password" method="POST" novalidate>

      <label for="password">New Password</label>
      <input
        type="password"
        id="password"
        name="password"
        required
        minlength="8"
      >

      <label for="confirmPassword">Confirm Password</label>
      <input
        type="password"
        id="confirmPassword"
        name="confirmPassword"
        required
        minlength="8"
      >

      <button type="submit">Reset Password</button>

    </form>
  </main>

  <script>
    const form = document.getElementById('resetForm');
    const password = document.getElementById('password');
    const confirmPassword = document.getElementById('confirmPassword');

    const popup = document.getElementById('passwordPopup');
    const popupTitle = document.getElementById('popupTitle');
    const popupMessage = document.getElementById('popupMessage');
    const popupClose = document.getElementById('popupClose');

    function showPopup(message, title = 'Password Error') {
      popupTitle.textContent = title;
      popupMessage.textContent = message;
      popup.style.display = 'flex';
    }

    const serverError = <%- JSON.stringify(error || null) %>;

if (serverError) {
  showPopup(serverError);
}

    popupClose.addEventListener('click', () => {
      popup.style.display = 'none';
    });

    form.addEventListener('submit', (event) => {
      const value = password.value;

      if (value.length < 8) {
        event.preventDefault();
        showPopup('Password must contain at least 8 characters.');
        return;
      }

      if (!/[A-Z]/.test(value)) {
        event.preventDefault();
        showPopup('Please include at least one uppercase letter.');
        return;
      }

      if (!/[a-z]/.test(value)) {
        event.preventDefault();
        showPopup('Please include at least one lowercase letter.');
        return;
      }

      if (!/[0-9]/.test(value)) {
        event.preventDefault();
        showPopup('Please include at least one number.');
        return;
      }

      if (!/[^A-Za-z0-9]/.test(value)) {
        event.preventDefault();
        showPopup('Please include at least one special character.');
        return;
      }

      if (value !== confirmPassword.value) {
        event.preventDefault();
        showPopup('Passwords do not match.');
        return;
      }
    });
  </script>

</body>
</html>
