
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password | NORIX</title>
  <link rel="stylesheet" href="/css/norix.css">

  <style>
    .reset-page {
      min-height: 100vh;
      background: #f5f3f2;
      font-family: Arial, sans-serif;
    }

    .reset-header {
      height: 60px;
      padding: 0 5%;
      background: #fff;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .reset-logo {
      color: #222;
      font-size: 22px;
      font-weight: 800;
      text-decoration: none;
    }

    .reset-logo span {
      color: #ff6500;
    }

    .reset-return {
      color: #ff6500;
      font-size: 11px;
      font-weight: bold;
      text-decoration: none;
    }

    .reset-card {
      width: 90%;
      max-width: 1050px;
      margin: 55px auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      background: #fff;
      border-radius: 5px;
      overflow: hidden;
      box-shadow: 0 5px 20px rgba(0,0,0,.08);
    }

    .reset-promo {
      background: linear-gradient(140deg, #171717, #35302d);
      color: #fff;
      padding: 45px 38px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .reset-label {
      color: #ff790f;
      font-size: 10px;
      font-weight: bold;
      letter-spacing: 1px;
    }

    .reset-promo h1 {
      font-size: 29px;
      line-height: 1.2;
      margin: 20px 0 14px;
    }

    .reset-promo h1 span {
      color: #ff790f;
    }

    .reset-promo p {
      color: #ccc;
      font-size: 13px;
      line-height: 1.7;
    }

    .reset-benefits {
      list-style: none;
      padding: 0;
      margin-top: 30px;
    }

    .reset-benefits li {
      color: #ddd;
      font-size: 12px;
      margin: 18px 0;
    }

    .reset-benefits li::before {
      content: "✓";
      color: #ff790f;
      margin-right: 10px;
    }

    .reset-promo-footer {
      color: #aaa;
      font-size: 10px;
      margin-top: 35px;
    }

    .reset-form-panel {
      padding: 45px;
      display: flex;
      align-items: center;
    }

    .reset-form-container {
      width: 100%;
      max-width: 390px;
      margin: auto;
    }

    .reset-step {
      color: #ff6500;
      font-size: 10px;
      font-weight: bold;
      letter-spacing: 1px;
    }

    .reset-form-container h2 {
      font-size: 25px;
      margin: 15px 0 10px;
      color: #222;
    }

    .reset-description {
      color: #777;
      font-size: 12px;
      line-height: 1.7;
      margin-bottom: 25px;
    }

    .reset-field {
      margin-bottom: 18px;
    }

    .reset-field label {
      display: block;
      font-size: 11px;
      font-weight: bold;
      margin-bottom: 9px;
      letter-spacing: .5px;
    }

    .reset-field label span {
      color: #ff6500;
    }

    .reset-field input {
      width: 100%;
      box-sizing: border-box;
      padding: 14px;
      border: 1px solid #ddd;
      border-radius: 3px;
      font-size: 13px;
      outline: none;
    }

    .reset-field input:focus {
      border-color: #ff6500;
    }

    .password-rules {
      background: #f7f7f7;
      padding: 12px;
      margin-top: 10px;
      border-radius: 3px;
    }

    .password-rules p {
      font-size: 10px;
      color: #999;
      margin: 6px 0;
    }

    .reset-submit {
      width: 100%;
      padding: 15px;
      background: #ff6500;
      color: #fff;
      border: none;
      border-radius: 3px;
      font-size: 11px;
      font-weight: bold;
      cursor: pointer;
      margin-top: 8px;
    }

    .reset-submit:hover {
      background: #e85b00;
    }

    .reset-back {
      text-align: center;
      margin-top: 22px;
      font-size: 12px;
      color: #777;
    }

    .reset-back a {
      color: #ff6500;
      font-weight: bold;
      text-decoration: none;
    }

    .reset-security {
      text-align: center;
      color: #999;
      font-size: 9px;
      margin-top: 30px;
    }

    .norix-popup-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.65);
      display: none;
      justify-content: center;
      align-items: center;
      padding: 20px;
      z-index: 99999;
      box-sizing: border-box;
    }

    .norix-popup {
      width: 100%;
      max-width: 430px;
      padding: 34px 30px;
      background: #fff;
      border-radius: 11px;
      text-align: center;
      box-sizing: border-box;
    }

    .norix-popup-icon {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: #fff0f0;
      color: #d62828;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
      font-weight: bold;
      margin: 0 auto 20px;
    }

    .norix-popup h3 {
      margin-bottom: 12px;
      color: #222;
    }

    .norix-popup p {
      color: #666;
      font-size: 14px;
      line-height: 1.6;
    }

    .norix-popup button {
      margin-top: 24px;
      padding: 13px 40px;
      background: #222;
      color: #fff;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }

    @media(max-width: 750px) {
      .reset-card {
        grid-template-columns: 1fr;
        margin: 25px auto;
      }

      .reset-promo {
        padding: 30px 25px;
      }

      .reset-form-panel {
        padding: 35px 25px;
      }
    }
  </style>
</head>

<body>

<div class="reset-page">

  <header class="reset-header">
    <a href="/" class="reset-logo">NORIX<span>.</span></a>
    <a href="/" class="reset-return">RETURN TO STORE →</a>
  </header>

  <main class="reset-card">

    <!-- LEFT PROMOTIONAL PANEL -->

    <section class="reset-promo">

      <div>
        <span class="reset-label">● NORIX ACCOUNT SECURITY</span>

        <h1>
          SECURE YOUR
          <span>ACCOUNT.</span>
        </h1>

        <p>
          Create a strong new password to protect
          your NORIX account and gaming experience.
        </p>

        <ul class="reset-benefits">
          <li>Protect your personal information</li>
          <li>Keep your account secure</li>
          <li>Use a strong and unique password</li>
          <li>Get back to your gaming experience</li>
        </ul>
      </div>

      <div class="reset-promo-footer">
        ● 256-BIT SSL ENCRYPTED
      </div>

    </section>

    <!-- RIGHT RESET FORM -->

    <section class="reset-form-panel">

      <div class="reset-form-container">

        <span class="reset-step">ACCOUNT RECOVERY</span>

        <h2>Create New Password</h2>

        <p class="reset-description">
          Choose a strong password to secure your NORIX account.
        </p>

        <form
          action="/reset-password"
          method="POST"
          id="resetForm"
          novalidate
        >

          <!-- NEW PASSWORD -->

          <div class="reset-field">

            <label for="password">
              NEW PASSWORD <span>*</span>
            </label>

            <input
              type="password"
              id="password"
              name="password"
              placeholder="Enter new password"
              autocomplete="new-password"
            >

            <div class="password-rules">
              <p id="length">✗ At least 8 characters</p>
              <p id="uppercase">✗ One uppercase letter (A-Z)</p>
              <p id="lowercase">✗ One lowercase letter (a-z)</p>
              <p id="number">✗ One number (0-9)</p>
              <p id="special">✗ One special character</p>
            </div>

          </div>

          <!-- CONFIRM PASSWORD -->

          <div class="reset-field">

            <label for="confirmPassword">
              CONFIRM NEW PASSWORD <span>*</span>
            </label>

            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              placeholder="Re-enter new password"
              autocomplete="new-password"
            >

          </div>

          <button type="submit" class="reset-submit">
            UPDATE PASSWORD →
          </button>

        </form>

        <div class="reset-back">
          Remember your password?
          <a href="/login">BACK TO LOGIN</a>
        </div>

        <div class="reset-security">
          ♢ SECURE PASSWORD UPDATE · NORIX SECURITY
        </div>

      </div>

    </section>

  </main>

</div>

<!-- CUSTOM POPUP -->

<div class="norix-popup-overlay" id="resetPopup"
  role="dialog" aria-modal="true" aria-labelledby="resetPopupTitle">

  <div class="norix-popup">
    <div class="norix-popup-icon">!</div>
    <h3 id="resetPopupTitle">Password Error</h3>
    <p id="resetPopupMessage"></p>
    <button type="button" id="resetPopupClose">OK</button>
  </div>

</div>

<script>
  const resetForm = document.getElementById('resetForm');

  const passwordInput = document.getElementById('password');
  const confirmPasswordInput = document.getElementById('confirmPassword');

  const popup = document.getElementById('resetPopup');
  const popupTitle = document.getElementById('resetPopupTitle');
  const popupMessage = document.getElementById('resetPopupMessage');
  const popupClose = document.getElementById('resetPopupClose');

  function showPopup(message, title = 'Password Error') {
    popupTitle.textContent = title;
    popupMessage.textContent = message;
    popup.style.display = 'flex';
    popupClose.focus();
  }

  function closePopup() {
    popup.style.display = 'none';
  }

  popupClose.addEventListener('click', closePopup);

  popup.addEventListener('click', (event) => {
    if (event.target === popup) closePopup();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closePopup();
  });

  // Backend error popup
  const serverError = <%- JSON.stringify(error || null) %>;

  if (serverError) {
    showPopup(serverError);
  }

  // Password rules
  const rules = {
    length: value => value.length >= 8,
    uppercase: value => /[A-Z]/.test(value),
    lowercase: value => /[a-z]/.test(value),
    number: value => /[0-9]/.test(value),
    special: value => /[^A-Za-z0-9]/.test(value)
  };

  passwordInput.addEventListener('input', () => {
    const value = passwordInput.value;

    Object.entries(rules).forEach(([id, check]) => {
      const element = document.getElementById(id);
      const valid = check(value);
      const originalText = element.textContent.slice(2);

      element.textContent = `${valid ? '✓' : '✗'} ${originalText}`;
      element.style.color = valid ? 'green' : '#d62828';
    });
  });

  // Form validation
  resetForm.addEventListener('submit', (event) => {
    event.preventDefault();

    const password = passwordInput.value;
    const confirmPassword = confirmPasswordInput.value;

    if (!password) {
      showPopup('Please enter your new password.', 'Missing Information');
      passwordInput.focus();
      return;
    }

    for (const [id, check] of Object.entries(rules)) {
      if (!check(password)) {
        const messages = {
          length: 'Password must contain at least 8 characters.',
          uppercase: 'Please include at least one uppercase letter.',
          lowercase: 'Please include at least one lowercase letter.',
          number: 'Please include at least one number.',
          special: 'Please include at least one special character.'
        };

        showPopup(messages[id], 'Weak Password');
        passwordInput.focus();
        return;
      }
    }

    if (!confirmPassword) {
      showPopup(
        'Please confirm your new password.',
        'Missing Information'
      );
      confirmPasswordInput.focus();
      return;
    }

    if (password !== confirmPassword) {
      showPopup(
        'Your password and confirmation password do not match.',
        'Password Mismatch'
      );
      confirmPasswordInput.focus();
      return;
    }

    HTMLFormElement.prototype.submit.call(resetForm);
  });
</script>

</body>
</html>
